/* 关于体系页面样式 */
.about-page {
  background: linear-gradient(180deg, #fcfcfc, #fff);
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.about-container {
  padding: 40rpx 30rpx;
}

/* 头部区域 */
.header-section {
  text-align: center;
  margin-bottom: 60rpx;
  padding: 60rpx 20rpx;
  background: linear-gradient(135deg, rgba(143, 188, 143, 0.1), rgba(143, 188, 143, 0.05));
  border-radius: 24rpx;
}

.main-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #2d3748;
  display: block;
  margin-bottom: 20rpx;
}

.accent-text {
  color: #8fbc8f;
}

.sub-title {
  font-size: 32rpx;
  color: #718096;
  display: block;
  line-height: 1.6;
}

/* 内容区块 */
.content-section {
  margin-bottom: 40rpx;
}

.section-card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2d3748;
  display: block;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #8fbc8f;
}

.section-content {
  font-size: 30rpx;
  color: #4a5568;
  line-height: 1.8;
  display: block;
}

/* 特色列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(143, 188, 143, 0.08);
  border-radius: 16rpx;
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #8fbc8f, #7aa97a);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.feature-content {
  flex: 1;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
  display: block;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 28rpx;
  color: #718096;
  line-height: 1.6;
  display: block;
}

/* 四维体系 */
.dimension-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.dimension-item {
  background: #fff;
  border: 2rpx solid rgba(143, 188, 143, 0.3);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  transition: all 0.3s;
}

.dimension-item:active {
  transform: scale(0.98);
  background: rgba(143, 188, 143, 0.05);
}

.dimension-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #8fbc8f;
  display: block;
  margin-bottom: 12rpx;
}

.dimension-pair {
  font-size: 28rpx;
  color: #4a5568;
  display: block;
  margin-bottom: 8rpx;
}

.dimension-desc {
  font-size: 24rpx;
  color: #718096;
  display: block;
}

/* 16种体质展示 */
.constitution-section {
  margin-bottom: 40rpx;
}

.constitution-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.constitution-item {
  background: linear-gradient(135deg, rgba(143, 188, 143, 0.15), rgba(143, 188, 143, 0.05));
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
}

.constitution-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2d3748;
  display: block;
}

/* 底部信息 */
.footer-section {
  text-align: center;
  padding: 40rpx 20rpx;
  margin-top: 20rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #a0aec0;
  display: block;
  line-height: 1.8;
}

.footer-link {
  color: #8fbc8f;
  font-weight: 500;
}

/* 引用说明 */
.quote-box {
  background: linear-gradient(135deg, rgba(143, 188, 143, 0.1), rgba(255, 255, 255, 0.8));
  border-left: 6rpx solid #8fbc8f;
  padding: 24rpx 28rpx;
  margin-top: 20rpx;
  border-radius: 0 16rpx 16rpx 0;
}

.quote-text {
  font-size: 28rpx;
  color: #4a5568;
  font-style: italic;
  line-height: 1.7;
  display: block;
}

/* 行动按钮 */
.action-section {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.start-button {
  background: linear-gradient(135deg, #8fbc8f, #7aa97a) !important;
  border: none;
  border-radius: 50rpx;
  color: #fff !important;
  font-size: 34rpx;
  font-weight: 500;
  padding: 28rpx 60rpx;
  width: 100%;
  box-shadow: 0 6rpx 20rpx rgba(143, 188, 143, 0.3);
}

/* 标准说明 */
.standard-info {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.standard-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
  display: block;
  margin-bottom: 12rpx;
}

.standard-desc {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.7;
  display: block;
}
