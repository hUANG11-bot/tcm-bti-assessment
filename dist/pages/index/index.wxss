.index-page{align-items:center;background:linear-gradient(180deg,#f7faf7 0%,#fff 100%);display:flex;flex-direction:column;justify-content:center;height:100vh;box-sizing:border-box;padding:0 50rpx;overflow:hidden}.hero-section{align-items:center;display:flex;flex-direction:column;max-width:650rpx;text-align:center;width:100%}.hero-content{margin-bottom:48rpx}.hero-title{color:#1a202c;display:flex;flex-direction:column;align-items:center;font-size:52rpx;font-weight:800;line-height:1.3;margin-bottom:32rpx}.accent-text{color:#8fbc8f;font-size:64rpx;margin-top:12rpx;position:relative}.accent-text::after{content:'';position:absolute;bottom:-8rpx;left:50%;transform:translateX(-50%);width:120rpx;height:5rpx;background:linear-gradient(90deg,transparent,#8fbc8f,transparent);border-radius:3rpx}.hero-description{display:flex;flex-direction:column;align-items:center;gap:12rpx;padding:0 10rpx}.desc-line{color:#5a6775;font-size:26rpx;text-align:center}.desc-line:last-child{color:#8fbc8f;font-size:24rpx;letter-spacing:3rpx;margin-top:6rpx}.action-buttons{display:flex;flex-direction:column;gap:20rpx;margin-bottom:48rpx;width:100%;max-width:480rpx}.primary-button{background:linear-gradient(135deg,#8fbc8f 0%,#6ba36b 100%)!important;border:none;border-radius:50rpx;box-sizing:border-box;color:#fff!important;font-size:34rpx;font-weight:700;padding:28rpx 50rpx;width:100%;box-shadow:0 8rpx 24rpx rgba(107,163,107,.4);letter-spacing:3rpx}.primary-button:active{transform:scale(0.98);box-shadow:0 4rpx 12rpx rgba(107,163,107,.25)}.secondary-button{background:#fff;border:2rpx solid #d1dbd1;border-radius:50rpx;box-sizing:border-box;color:#5a6775;font-size:28rpx;font-weight:500;padding:22rpx 50rpx;width:100%;letter-spacing:1rpx}.secondary-button:active{background:#f7faf7;border-color:#8fbc8f}.features-grid{display:grid;gap:16rpx;grid-template-columns:repeat(4,1fr);width:100%;max-width:620rpx}.feature-item{align-items:center;background:linear-gradient(180deg,#fff 0%,#fafcfa 100%);border:none;border-radius:14rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04);display:flex;flex-direction:column;gap:6rpx;padding:22rpx 10rpx}.feature-title{color:#8fbc8f;font-size:32rpx;font-weight:800}.feature-desc{color:#718096;font-size:20rpx;white-space:nowrap}