.profile-page{background:linear-gradient(180deg,#f7faf7 0%,#fff 100%);min-height:100vh}.profile-container{display:flex;flex-direction:column;gap:24rpx;padding:32rpx 36rpx 120rpx}.loading-container{align-items:center;color:#718096;display:flex;font-size:32rpx;justify-content:center;min-height:100vh}.user-info-card{margin-bottom:0;background:linear-gradient(135deg,#fff 0%,#f0f7f0 100%);border-radius:28rpx;box-shadow:0 4rpx 20rpx rgba(143,188,143,.12);overflow:hidden}.user-info{align-items:center;display:flex;flex-direction:column;gap:16rpx;padding:40rpx 32rpx;text-align:center}.user-avatar{display:none}.user-details{display:flex;flex:1;flex-direction:column;align-items:center;gap:12rpx}.user-name{color:#1a202c;font-size:44rpx;font-weight:800;position:relative;padding-bottom:16rpx}.user-name::after{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:60rpx;height:4rpx;background:linear-gradient(90deg,transparent,#8fbc8f,transparent);border-radius:2rpx}.user-email{color:#5a6775;font-size:26rpx}.user-id{color:#8fbc8f;font-size:22rpx;background:rgba(143,188,143,.1);padding:8rpx 20rpx;border-radius:20rpx;display:inline-block;max-width:fit-content;letter-spacing:1rpx}.not-logged-in{align-items:center;display:flex;flex-direction:column;gap:20rpx;justify-content:center;padding:48rpx 20rpx}.not-logged-in-text{color:#1a202c;font-size:36rpx;font-weight:700}.not-logged-in-desc{color:#5a6775;font-size:26rpx;line-height:1.6;text-align:center}.action-section{display:flex;flex-direction:column;gap:20rpx;padding:0}.login-button{background:linear-gradient(135deg,#8fbc8f 0%,#6ba36b 100%)!important;border:none;border-radius:50rpx;color:#fff!important;font-size:30rpx;font-weight:600;padding:24rpx 50rpx;width:100%;box-shadow:0 6rpx 20rpx rgba(107,163,107,.3);letter-spacing:2rpx}.login-button:active{transform:scale(0.98);box-shadow:0 4rpx 12rpx rgba(107,163,107,.25)}.logout-button{background:#fff;border:2rpx solid #d1dbd1;border-radius:50rpx;color:#5a6775;font-size:26rpx;font-weight:500;padding:20rpx 50rpx;width:100%;letter-spacing:1rpx}.logout-button:active{background:#f7faf7;border-color:#8fbc8f}.menu-section{margin-top:4rpx}.menu-section .taro_card{background:linear-gradient(180deg,#fff 0%,#fafcfa 100%);border-radius:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);overflow:hidden}.menu-section .taro_card_hd{padding:24rpx 28rpx 12rpx;border-bottom:none}.menu-section .taro_card_hd .taro_card_hd__title{color:#1a202c;font-size:30rpx;font-weight:700}.menu-item{align-items:center;background:transparent;cursor:pointer;display:flex;justify-content:space-between;padding:32rpx 28rpx;transition:background .2s}.menu-item:active{background:#f7faf7}.menu-item:not(:last-child){border-bottom:1rpx solid #e8f0e8}.menu-item-icon{width:44rpx;height:44rpx;background:linear-gradient(135deg,rgba(143,188,143,.15) 0%,rgba(143,188,143,.08) 100%);border-radius:12rpx;display:flex;align-items:center;justify-content:center;margin-right:20rpx;font-size:24rpx}.menu-item-content{display:flex;align-items:center;flex:1}.menu-item-text{color:#1a202c;font-size:30rpx;font-weight:500}.menu-item-arrow{color:#c0c8c0;font-size:28rpx}.about-section{margin-top:8rpx}.about-section .taro_card{background:linear-gradient(180deg,#fff 0%,#fafcfa 100%);border-radius:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04)}.about-section .taro_card_hd{padding:24rpx 28rpx 12rpx;border-bottom:none}.about-section .taro_card_hd .taro_card_hd__title{color:#1a202c;font-size:30rpx;font-weight:700}.about-text{color:#5a6775;font-size:24rpx;line-height:1.9;text-align:center;white-space:pre-line;padding:16rpx 24rpx 24rpx}.history-section{margin-top:4rpx}.history-section .taro_card{background:linear-gradient(180deg,#fff 0%,#fafcfa 100%);border-radius:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);overflow:hidden}.history-header{cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:28rpx 28rpx;background:transparent;transition:background .2s}.history-header:active{background:#f7faf7}.history-title{color:#1a202c;font-size:30rpx;font-weight:700}.history-toggle{color:#8fbc8f;font-size:26rpx;font-weight:600;transition:transform 0.3s}.history-toggle.expanded{transform:none}.history-content{max-height:0;overflow:hidden;transition:max-height 0.3s ease-out;background:linear-gradient(180deg,#f7faf7 0%,#f0f5f0 100%)}.history-content.expanded{max-height:3000rpx}.history-list{display:flex;flex-direction:column;gap:14rpx;padding:16rpx 20rpx 20rpx}.history-item{background:#fff;border:none;border-radius:16rpx;padding:24rpx;display:flex;flex-direction:column;gap:14rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04);transition:transform .2s,box-shadow .2s}.history-item:active{transform:scale(0.98);box-shadow:0 1rpx 4rpx rgba(0,0,0,.02)}.history-item-header{display:flex;justify-content:space-between;align-items:center;cursor:pointer}.history-date{color:#5a6775;font-size:24rpx}.history-type{color:#fff;font-size:24rpx;font-weight:600;background:linear-gradient(135deg,#8fbc8f 0%,#6ba36b 100%);padding:6rpx 18rpx;border-radius:16rpx}.history-secondary{color:#5a6775;font-size:22rpx;margin-top:2rpx;padding-left:4rpx}.history-actions{display:flex;justify-content:space-between;align-items:center;margin-top:10rpx;padding-top:14rpx;border-top:1rpx solid #e8f0e8}.history-arrow{color:#8fbc8f;font-size:26rpx;cursor:pointer;font-weight:500}.history-delete-btn{color:#ff6b6b;font-size:24rpx;cursor:pointer;padding:6rpx 14rpx;border-radius:8rpx;background:rgba(255,107,107,.08)}.loading-text{color:#5a6775;font-size:26rpx;text-align:center;padding:48rpx 0}.empty-history{color:#8fbc8f;font-size:26rpx;text-align:center;padding:48rpx 0}.stats-section{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin-top:4rpx}.stat-item{background:linear-gradient(180deg,#fff 0%,#fafcfa 100%);border-radius:16rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04);padding:24rpx 16rpx;display:flex;flex-direction:column;align-items:center;gap:8rpx}.stat-value{color:#8fbc8f;font-size:40rpx;font-weight:800}.stat-label{color:#5a6775;font-size:22rpx}.quick-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:4rpx}.quick-action-item{background:linear-gradient(180deg,#fff 0%,#fafcfa 100%);border-radius:16rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04);padding:28rpx 20rpx;display:flex;align-items:center;gap:16rpx;cursor:pointer;transition:all .2s}.quick-action-item:active{transform:scale(0.98);background:#f7faf7}.quick-action-icon{width:52rpx;height:52rpx;background:linear-gradient(135deg,rgba(143,188,143,.2) 0%,rgba(143,188,143,.1) 100%);border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx}.quick-action-text{color:#1a202c;font-size:28rpx;font-weight:500}.section-title{color:#1a202c;font-size:28rpx;font-weight:700;margin-bottom:12rpx;padding-left:8rpx}